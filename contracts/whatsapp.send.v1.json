{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-opportunity-radar.invalid/contracts/whatsapp.send.v1.json",
  "title": "Payload whatsapp.send v1",
  "description": "Envío aprobado. La aprobación liga propietario, destinatario, cuenta, hash, propósito, versión y vencimiento; el worker verifica content_sha256 = sha256(UTF-8 de text) y el ledger antes del efecto (no expresable en JSON Schema).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipient_ref", "approval_ref", "content_sha256", "text"],
  "properties": {
    "schema_version": {"$ref": "common.v1.json#/$defs/schema_version"},
    "recipient_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"},
    "approval_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"},
    "content_sha256": {"$ref": "common.v1.json#/$defs/sha256"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
