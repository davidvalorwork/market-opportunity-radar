{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-opportunity-radar.invalid/contracts/llm.contextual_reply.v1.json",
  "title": "Contextual reply v1 candidate A18; B review required",
  "description": "Private structured model output, not transport or authority. Statements may contain private data and must remain in owner-bound encrypted storage. Citation association is not truth. No tool calls, queries, recipients or approvals are authorized by validation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scope", "claims", "unknowns", "contradictions"],
  "properties": {
    "schema_version": {"$ref": "common.v1.json#/$defs/schema_version"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["owner_ref", "account_ref", "chat_ref", "provider_message_ref"], "properties": {
      "owner_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"},
      "account_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"},
      "chat_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"},
      "provider_message_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"}
    }},
    "claims": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "statement", "citations"], "properties": {
      "kind": {"enum": ["extracted", "inference", "interlocutor"]},
      "statement": {"type": "string", "minLength": 1, "maxLength": 1024},
      "citations": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["source_ref", "start", "end"], "properties": {
        "source_ref": {"$ref": "common.v1.json#/$defs/opaque_ref"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}
      }}}
    }, "allOf": [{"if": {"properties": {"kind": {"const": "interlocutor"}}}, "then": {"properties": {"citations": {"maxItems": 0}}}, "else": {"properties": {"citations": {"minItems": 1}}}}]}},
    "unknowns": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "contradictions": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["description", "source_refs"], "properties": {
      "description": {"type": "string", "minLength": 1, "maxLength": 512},
      "source_refs": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "common.v1.json#/$defs/opaque_ref"}}
    }}}
  }
}
